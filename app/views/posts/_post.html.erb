<div id="<%= dom_id post %>">
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= post.body %>
  </p>
  <p> Comments: </p>
  <div id="comments">
    <% if post.comments.any? %>
      <%= render post.comments %>
    <% else %>
      <p>No comments yet.</p>
    <% end %>
  </div>
  <p>
    <strong>Add Comment:</strong>
    <%= render 'comments/form', post: @post %>
  </p>

</div>
